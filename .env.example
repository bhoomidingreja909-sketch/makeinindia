# Copy to .env.local (never commit real values).

# --- News (server-side only; do NOT prefix with NEXT_PUBLIC_) ---
# Free key: https://gnews.io  -> dashboard -> API key
GNEWS_API_KEY=your-gnews-api-key-here
# Max provider calls per UTC day (free plan = 100; keep headroom)
NEWS_DAILY_BUDGET=90
# Cache lifetime per sector in hours (27 sectors x 3 fetches/day = 81 calls)
NEWS_CACHE_TTL_HOURS=8
# How many days of history your plan returns (free plan ~30)
NEWS_HISTORY_DAYS=30
# Optional official PIB RSS feed (verify the URL on pib.gov.in/RssMain.aspx)
PIB_RSS_URL=

# --- Supabase (server-side only) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
